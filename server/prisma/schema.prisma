generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum GroupStatus {
  recruiting
  full
  pending_confirmation
  pending_activation
  confirming
  disputed
  active
  cancelled
  ended
}

enum ApplicationStatus {
  pending
  approved
  rejected
  removed
  left
  cancelled
}

enum SubscriptionStatus {
  pending
  active
  ended
}

enum TokenTransactionType {
  topup
  escrow
  release
  refund
}

enum ConversationType {
  group
  dm
  system
}

enum PresenceStatus {
  online
  busy
  offline
}

enum NotificationType {
  application_sent
  application_approved
  application_rejected
  application_cancelled
  new_application
  group_created
  group_activated
  group_chat_opened
  fill_service_info
  service_info_filled
  group_full
  group_ended
  group_cancelled
  group_renewal
  member_left
  member_removed
  service_info_issue
  escrow_released
  dispute_raised
  dispute_resolved
  upcoming_renewal
  system
}

// ── Models ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  name          String
  phone         String
  avatarColor   String?
  avatarInitial String?
  showAvatar    Boolean  @default(true)
  presenceStatus PresenceStatus @default(online)
  bio           String?  @db.VarChar(500)
  creditScore   Int      @default(100)
  tokenBalance  Int      @default(0)
  isAdmin       Boolean  @default(false)
  // 軟刪除：非 null 代表帳號已停用，登入/refresh 一律拒絕；保留資料供日後申請恢復
  deactivatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hostedGroups      Group[]              @relation("HostedGroups")
  applications      Application[]
  members           Member[]
  subscriptions     Subscription[]
  notifications     Notification[]
  favorites         Favorite[]
  sentMessages      Message[]
  tokenTransactions TokenTransaction[]
  paymentMethods    PaymentMethod[]
  hostReviews       Review[]             @relation("HostReviews")
  authoredReviews   Review[]             @relation("AuthoredReviews")
  credentialComments CredentialComment[]

  @@map("users")
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     String
  last4     String
  expiry    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("payment_methods")
}

model Service {
  id       String  @id
  name     String
  category String
  logoUrl  String?
  plans    Json    // [{ id, name, maxMembers, monthlyFee, currency }]

  groups   Group[]

  @@map("services")
}

model Group {
  id              String      @id @default(cuid())
  hostId          String
  host            User        @relation("HostedGroups", fields: [hostId], references: [id])
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  planId          String
  planName        String
  status          GroupStatus @default(recruiting)
  maxMembers      Int
  currentMembers  Int         @default(0)
  monthlyFee      Float
  currency        String      @default("TWD")
  rules           String?
  tags            Json        @default("[]")
  minCreditScore  Int         @default(0)
  minGroupAge     Int         @default(0)
  billingCycle    String?
  nextBillingDate DateTime?
  escrowTokens    Int         @default(0)
  // 無官方多人邀請機制的服務（sharingMethod: shared_credentials，只存在前端 serviceCatalog，後端不知道這個分類）
  // 鎖定群組時由團主一次性提供帳號密碼，存在這裡讓所有成員都能在「填寫帳號」畫面直接看到，不用回頭翻聊天室訊息
  sharedCredentials String?
  // 鎖定群組時設定為鎖定時間 + 24h，pending_confirmation 階段的填寫帳號資訊截止時間，僅供前端顯示倒數，逾期不會有任何自動處理
  serviceInfoDeadline DateTime?
  confirmDeadline DateTime?
  disputeDeadline DateTime?
  // 團主在確認期（confirming）調整下次扣款日的額度用掉了沒有：非 null 代表這個計費週期已經調整過，
  // 不能再調第二次；進入新週期（/lock 第一次鎖定、/renew 續訂）時重置回 null，重新給一次額度
  billingDateAdjustedAt     DateTime?
  billingDateAdjustmentNote String?
  // 這個群組有沒有成功啟用過服務：/activate 只在第一次（false）才會重新計算 nextBillingDate
  // （從實際啟用當下起算一個週期），確保第一期不會因為鎖定到啟用中間的延誤而縮水；後續每次
  // 續訂再啟用都固定沿用 /renew 已經算好、錨定在「上一期排定日期 + 一個週期」的值，避免扣款日
  // 每期都因為啟用延誤往後漂移。真的遇到需要延後的情況交給團主用「調整下次扣款日」手動處理
  hasActivatedOnce Boolean @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  applications      Application[]
  members           Member[]
  subscriptions     Subscription[]
  favorites         Favorite[]
  conversations     Conversation[]
  notifications     Notification[]
  tokenTransactions TokenTransaction[]
  reviews           Review[]
  credentialComments CredentialComment[]

  @@index([status])
  @@map("groups")
}

model Application {
  id        String            @id @default(cuid())
  groupId   String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(pending)
  message   String?
  // 送出申請當下實際代管扣款的金額（見 applications.js 的 POST /）。撤回／拒絕退款時要用這個值，
  // 不能用 computeSeatCost(group) 重新計算——群組的 monthlyFee/billingCycle 之後可能被團主改掉，
  // 用即時價格算退款會跟當初真正扣的錢對不上。舊資料或非經 API 建立的 seed 資料可能沒有這個值，
  // 退款時要 fallback 回 computeSeatCost(group)。
  escrowAmount Int?
  // 只有 pending/approved（進行中）時為 'active'，其餘狀態為 null。
  // MySQL 的 unique index 允許多個 null 並存，藉此模擬「同一使用者對同一群組最多一筆進行中申請」
  // 的 partial unique index，避免併發送出申請時 race condition 造成重複的 pending 申請。
  activeKey String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([groupId, userId, activeKey])
  @@map("applications")
}

model Member {
  id                   String   @id @default(cuid())
  groupId              String
  group                Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceInfo          Json?
  serviceInfoIssueNote String?
  serviceInfoIssueEvidenceUrl String?
  disputeEvidenceUrl   String?
  confirmedAt          DateTime?
  joinedAt             DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([groupId, userId])
  @@map("members")
}

model Subscription {
  id              String             @id @default(cuid())
  groupId         String
  group           Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          SubscriptionStatus @default(pending)
  lastPaidAt      DateTime?
  nextBillingDate DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([groupId, userId])
  @@map("subscriptions")
}

model TokenTransaction {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TokenTransactionType
  amount        Int
  relatedGroupId String?
  relatedGroup  Group?               @relation(fields: [relatedGroupId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime             @default(now())

  @@map("token_transactions")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isPublic  Boolean          @default(false)
  type      NotificationType
  title     String
  message   String
  meta      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@map("favorites")
}

model Conversation {
  id           String           @id @default(cuid())
  type         ConversationType
  groupId      String?
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  participants Json             @default("[]")
  initiatorId  String?
  unreadCounts Json             @default("{}")
  lastReadAt   Json             @default("{}")
  lastMessage  Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  content        String
  type           String       @default("text")
  actionType     String?
  payload        Json?
  attachmentUrl  String?      @db.VarChar(500)
  createdAt      DateTime     @default(now())

  @@map("messages")
}

// hostId 是建立當下對 group.hostId 的快照，刻意不透過 group 反查——
// 目前沒有「轉讓團主」功能，group.hostId 視為不可變；若未來新增轉讓功能，
// 需要決定歷史評價要保留在原團主身上還是跟著轉移，屆時再處理遷移邏輯
model Review {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hostId    String
  host      User     @relation("HostReviews", fields: [hostId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([groupId, authorId])
  @@map("reviews")
}

// 「帳號資訊」分頁底下的留言區（團主提供帳密的服務限定），團主與該群組所有成員都能看、都能留言，
// 用來針對帳密內容直接溝通（例如密碼錯誤、詢問 Profile 名稱），不透過群組聊天室避免訊息混在一起
model CredentialComment {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.VarChar(500)
  attachmentUrl String? @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([groupId])
  @@map("credential_comments")
}
