generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum GroupStatus {
  recruiting
  full
  pending_confirmation
  pending_activation
  confirming
  disputed
  active
  cancelled
  ended
}

enum ApplicationStatus {
  pending
  approved
  rejected
  removed
  left
  withdrawn
}

enum SubscriptionStatus {
  pending
  active
  ended
}

enum TokenTransactionType {
  topup
  escrow
  release
  refund
}

enum ConversationType {
  group
  dm
  system
}

enum NotificationType {
  application_sent
  application_approved
  application_rejected
  new_application
  group_created
  group_activated
  group_chat_opened
  group_full
  group_ended
  member_joined
  member_left
  member_removed
  service_info_issue
  token_topup
  escrow_released
  dispute_raised
  system
}

// ── Models ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  name          String
  phone         String
  avatarColor   String?
  avatarInitial String?
  creditScore   Int      @default(100)
  tokenBalance  Int      @default(0)
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hostedGroups      Group[]              @relation("HostedGroups")
  applications      Application[]
  members           Member[]
  subscriptions     Subscription[]
  notifications     Notification[]
  favorites         Favorite[]
  sentMessages      Message[]
  refreshTokens     RefreshToken[]
  tokenTransactions TokenTransaction[]
  paymentMethods    PaymentMethod[]
  hostReviews       Review[]             @relation("HostReviews")
  authoredReviews   Review[]             @relation("AuthoredReviews")

  @@map("users")
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     String
  last4     String
  expiry    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("payment_methods")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Service {
  id       String  @id
  name     String
  category String
  logoUrl  String?
  plans    Json    // [{ id, name, maxMembers, monthlyFee, currency }]

  groups   Group[]

  @@map("services")
}

model Group {
  id              String      @id @default(cuid())
  hostId          String
  host            User        @relation("HostedGroups", fields: [hostId], references: [id])
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  planId          String
  planName        String
  status          GroupStatus @default(recruiting)
  maxMembers      Int
  currentMembers  Int         @default(0)
  monthlyFee      Float
  currency        String      @default("TWD")
  rules           String?
  tags            Json        @default("[]")
  minCreditScore  Int         @default(0)
  minGroupAge     Int         @default(0)
  billingCycle    String?
  nextBillingDate DateTime?
  escrowTokens    Int         @default(0)
  confirmDeadline DateTime?
  disputeDeadline DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  applications      Application[]
  members           Member[]
  subscriptions     Subscription[]
  favorites         Favorite[]
  conversations     Conversation[]
  notifications     Notification[]
  tokenTransactions TokenTransaction[]
  reviews           Review[]

  @@map("groups")
}

model Application {
  id        String            @id @default(cuid())
  groupId   String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(pending)
  message   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("applications")
}

model Member {
  id                   String   @id @default(cuid())
  groupId              String
  group                Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceInfo          Json?
  serviceInfoIssueNote String?
  disputeEvidenceUrl   String?
  confirmedAt          DateTime?
  joinedAt             DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([groupId, userId])
  @@map("members")
}

model Subscription {
  id              String             @id @default(cuid())
  groupId         String
  group           Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          SubscriptionStatus @default(pending)
  lastPaidAt      DateTime?
  nextBillingDate DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([groupId, userId])
  @@map("subscriptions")
}

model TokenTransaction {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TokenTransactionType
  amount        Int
  relatedGroupId String?
  relatedGroup  Group?               @relation(fields: [relatedGroupId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime             @default(now())

  @@map("token_transactions")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isPublic  Boolean          @default(false)
  type      NotificationType
  title     String
  message   String
  meta      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@map("favorites")
}

model Conversation {
  id           String           @id @default(cuid())
  type         ConversationType
  groupId      String?
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  participants Json             @default("[]")
  initiatorId  String?
  unreadCounts Json             @default("{}")
  lastReadAt   Json             @default("{}")
  lastMessage  Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  content        String
  type           String       @default("text")
  actionType     String?
  payload        Json?
  createdAt      DateTime     @default(now())

  @@map("messages")
}

// hostId 是建立當下對 group.hostId 的快照，刻意不透過 group 反查——
// 目前沒有「轉讓團主」功能，group.hostId 視為不可變；若未來新增轉讓功能，
// 需要決定歷史評價要保留在原團主身上還是跟著轉移，屆時再處理遷移邏輯
model Review {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hostId    String
  host      User     @relation("HostReviews", fields: [hostId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([groupId, authorId])
  @@map("reviews")
}
